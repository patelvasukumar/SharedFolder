        "name": "Event -> notification",
        "func": "const e = msg.payload;\nconst text = {\n  BOOT: 'MEGA-1 started (' + e.detail + ')',\n  PASSCODE_SAVED: 'Passcode saved on MEGA-1',\n  PASSCODE_MISMATCH: 'Keypad: the two passcodes did not match',\n  PASSCODE_WRONG: 'Keypad: wrong passcode',\n  ACCESS_GRANTED: 'Keypad: access granted',\n  RESET_DONE: 'System reset - enter the passcode again',\n  OK: e.detail,\n  ERROR: 'Error: ' + e.detail\n}[e.event] || (e.event + ' ' + e.detail);\nmsg.payload = text;\nreturn msg;",
