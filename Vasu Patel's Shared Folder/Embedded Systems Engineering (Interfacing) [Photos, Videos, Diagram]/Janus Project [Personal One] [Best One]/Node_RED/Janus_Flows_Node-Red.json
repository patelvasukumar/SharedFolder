    {
        "id": "aac1db12e2af0a01",
        "type": "function",
        "z": "afbc8ed7f47877e8",
        "name": "Parse JSON line",
        "func": "const line = String(msg.payload).trim();\nif (!line.startsWith('{')) return null;\nlet data;\ntry { data = JSON.parse(line); } catch (e) { node.status({fill:'red', shape:'ring', text:'bad line'}); return null; }\nmsg.payload = data;\nif (data.type === 'telemetry') {\n    node.status({fill: data.link ? 'green' : 'yellow', shape: 'dot', text: data.state + (data.link ? '' : ' (no MEGA-2)')});\n    return [msg, null];\n}\nif (data.type === 'event') return [null, msg];\nreturn null;",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 100,
        "wires": [
            [
                "132fa81a825735fe",
                "907e82c16a0cf0f0"
            ],
            [
                "6bca6a5d7fa25915",
                "907e82c16a0cf0f0"
            ]
        ]
    },
    {
        "id": "132fa81a825735fe",
        "type": "function",
        "z": "afbc8ed7f47877e8",
        "name": "Split telemetry",
        "func": "const d = msg.payload;\nconst out = [];\nconst fmt = (v) => (v === null || v === undefined) ? null : {payload: v};\nout[0] = fmt(d.temperature);\nout[1] = fmt(d.humidity);\nout[2] = {payload: d.motor ? 'ON' : 'OFF'};\nout[3] = {payload: d.night ? 'ACTIVE (22.0 \\u00b0C)' : 'Off'};\nout[4] = {payload: d.motion ? 'Detected' : 'None'};\nout[5] = {payload: d.alert ? 'OBJECT < 20 cm - fan stopped' : 'Clear'};\nlet state = d.state;\nif (!d.link) state += ' (MEGA-2 not responding)';\nout[6] = {payload: state};\nout[7] = {payload: (d.target ? d.target.toFixed(1) : '--') + ' \\u00b0C   (user: ' + (d.preferred ? d.preferred.toFixed(1) : '--') + ' \\u00b0C)'};\nconst chart = [];\nif (d.temperature !== null) chart.push({topic: 'Temperature (\\u00b0C)', payload: d.temperature});\nif (d.humidity !== null) chart.push({topic: 'Humidity (%)', payload: d.humidity});\nout[8] = chart.length ? chart : null;\nout[9] = {payload: d.motorSeconds + ' s'};\nout[10] = {payload: d.light + ' / 1023'};\nreturn out;",
        "outputs": 11,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 80,
        "wires": [
            [
                "8c38d6ed84c8fea5"
            ],
            [
