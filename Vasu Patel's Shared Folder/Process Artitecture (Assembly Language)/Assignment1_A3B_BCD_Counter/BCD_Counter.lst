
as12, an absolute assembler for Motorola MCU's, version 1.2h

                        ; BCD_Counter.asm
                        ; Author:               D. Haley, Faculty
                        ; Modified by:          Vasukumar Patel, Sabit Naim
                        ; Student Number(s):     041153940, 041155239
                        ; Course:               CST8216
                        ; Date:                 24th July 2025
                        ;
                        ; Purpose       BCD Counter $00 - $15 (BCD) using Hex Displays
                        ;               and a single register, Accumulator A, for the count
                        ;               The range of counting can be altered by changing the
                        ;               FIRST_BCD and END_BCD constants
                        ;
                        ; ***** DO NOT CHANGE ANY CODE BETWEEN THESE MARKERS *****
                        ; Library Routines  - to be used in your solution
                        ;
                        
2117                    Config_Hex_Displays         equ        $2117
211f                    Delay_Ms                    equ        $211F
2139                    Hex_Display                 equ        $2139
2144                    Extract_Msb                 equ        $2144
2149                    Extract_Lsb                 equ        $2149
                        
                        ; Program Constants - to be used in your solution
2000                    STACK           equ     $2000
                                                        ; Port P (PPT) Display Selection Values
000e                    DIGIT3_PP0      equ     %1110   ; Left-most display MSB
000d                    DIGIT2_PP1      equ     %1101   ; 2nd from left-most display LSB
                        
                        ; Delay Subroutine Value  - to be used in your solution
00fa                    DVALUE  equ     #250            ; Delay value (base 10) 0 - 255 ms
                                                        ; 125 = 1/8 second <- good for Dragon12 Board
                        
                        ; ***** END OF DO NOT CHANGE ANY CODE BETWEEN THESE MARKERS *****
                        
                        ; BCD Count constants  - to be used in your solution
                        ; Changing these values will change the Starting and End BCD counts
                        
0000                    FIRST_BCD        equ     $00     ; Starting BCD count
0015                    END_BCD          equ     $15     ; Ending BCD count 0
                        
2000                            org     $2000
2000 cf 20 00           Start   lds     #STACK          ; Initialize the Stack
                        
2003 16 21 17                   jsr     Config_Hex_Displays ; Use the Hex Displays to display the count
                                ; Continually Count FIRST_BCD ... END_BCD ... FIRST_BCD ... END_BCD
2006 86 00                      ldaa    #FIRST_BCD     ; loading the first bcd value in accumulator A with immidate addressing mode
2008 36                 Loop:   psha                    ; pusing the value on the stack
2009 16 21 44                   jsr     Extract_Msb       ; extract MSB
200c c6 0e                      ldab    #DIGIT3_PP0       ; loading value 2 with immidate addressing mode
200e 16 21 39                   jsr     Hex_Display      ; displaying HEX value
2011 86 fa                      ldaa    #DVALUE            ; loading delay value into accumulator A with immidate mode
2013 16 21 1f                   jsr     Delay_Ms           ; going into subrotine
2016 32                         pula                        ; taking the value from stack
2017 36                         psha
2018 16 21 49                   jsr     Extract_Lsb         ; extract LSB
201b c6 0d                      ldab    #DIGIT2_PP1          ; loading into accumulator B
201d 16 21 39                   jsr     Hex_Display         ; going into subroute to display the value
2020 86 fa                      ldaa    #DVALUE             ; using immidate mode to load the value
2022 16 21 1f                   jsr     Delay_Ms           ; going into subroute
                        
2025 32                         pula                       ; taking the value from stack and adding it on accumulator A
2026 8b 01                      adda    #$01                ; adding 1 into A
2028 18 07                      daa                          ; using daa adjusting the numbers
202a 81 15                      cmpa    #END_BCD              ; compare B with the value by using immidate mode
202c 23 da                      bls     Loop                  ; branching to the loop if value is lower or same
202e 86 00                      ldaa    #FIRST_BCD            ; loading into accumulator A with immidate mode
2030 20 d6                      bra     Loop                  ; branch to the loop
                        
                        	end                           ; end of the program

